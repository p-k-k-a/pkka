a":{"type":"array","items":{"$ref":"#/components/schemas/TagResponse"}}}}}}}},"/api/public/posts":{"get":{"tags":["Posts"],"summary":"List of published posts","description":"Available without authentication. Posts are ordered from newest to oldest.\nPagination parameters: page (default 0), size (default 10).\n","operationId":"listPosts","parameters":[{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":10,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagePostSummaryResponse"}}}}}}},"/api/public/posts/{slug}":{"get":{"tags":["Posts"],"summary":"Single post by slug","description":"Available without authentication. Returns 404 if the post does not exist or is a draft.","operationId":"getPost","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PostResponse"}}}},"404":{"description":"Post does not exist or is not published"}}}},"/api/public/events":{"get":{"tags":["Events"],"summary":"List of upcoming events (optional filtering by tags)","operationId":"listEvents","parameters":[{"name":"tags","in":"query","required":false,"schema":{"type":"array","items":{"type":"string"},"uniqueItems":true}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["startsAt,ASC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageEventListItemDto"}}}}}}},"/api/public/events/{id}":{"get":{"tags":["Events"],"summary":"Details of a single event","operationId":"getEventById","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventDetailsDto"}}}}}}},"/api/public/auth/post-logout":{"get":{"tags":["web-logout-redirect-controller"],"operationId":"postLogout","responses":{"200":{"description":"OK"}}}},"/api/me":{"get":{"tags":["Me"],"summary":"Current user info","description":"Returns identity claims and realm roles for the currently authenticated user.\nWorks for both web (OIDC session) and mobile (Bearer JWT) flows.\nRoles are returned without the ROLE_ prefix.\n","operationId":"me","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MeResponse"}}}}}}},"/api/applications/me":{"get":{"tags":["Applications"],"summary":"Get the current user's application","operationId":"getMine","responses":{"200":{"description":"The user's most recent application","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApplicationResponse"}}}},"404":{"description":"The user has no application"}}}},"/api/alumni":{"get":{"tags":["Alumni"],"summary":"Search and list alumni","description":"Paginated, filterable alumni directory of verified alumni only (users without an approved\napplication never appear here, even if they hold a local account). `q` matches\n(case-insensitively, substring) against first/last name (unless the alumnus hides their name),\ncurrent position, company and assigned skill tag names. `tagIds` matches alumni who have at\nleast one of the given skill tags (OR semantics). `mentor=true`/`mentor=false` restricts to\nalumni who are/aren't willing to mentor. `graduationYearFrom`/`graduationYearTo` bound the\ngraduation year inclusively, and either may be given on its own to leave that end open.\nAll filters are combined with AND.\nUnknown tag IDs simply match no one instead of returning an error, since this is a search\nfilter rather than a write operation.\nSortable fields are columns of the alumnus' own record: `lastName`, `firstName`,\n`graduationYear`, `createdAt`. Requesting any other sort property is rejected with 400.\n","operationId":"listAlumni","parameters":[{"name":"q","in":"query","required":false,"schema":{"type":"string"}},{"name":"tagIds","in":"query","required":false,"schema":{"type":"array","items":{"type":"string","format":"uuid"},"uniqueItems":true}},{"name":"mentor","in":"query","required":false,"schema":{"type":"boolean"}},{"name":"graduationYearFrom","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"graduationYearTo","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["createdAt,DESC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageAlumniListItemResponse"}}}},"400":{"description":"Unsupported sort property","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/alumni/{id}":{"get":{"tags":["Alumni"],"summary":"Get public alumni profile by user id","operationId":"getAlumniProfile","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AlumniProfileResponse"}}}},"404":{"description":"No user with the given id, or that user is not a verified alumnus (no approved application)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/admin/applications":{"get":{"tags":["Admin Applications"],"summary":"List applications with full details, filtered by status (newest first)","operationId":"listAdminApplications","parameters":[{"name":"status","in":"query","required":false,"schema":{"type":"string","default":"UNDER_REVIEW","enum":["UNDER_REVIEW","APPROVED","REJECTED"]}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageAdminApplicationResponse"}}}}}}},"/api/admin/applications/{id}":{"get":{"tags":["Admin Applications"],"summary":"Get full details of a single application","operationId":"getAdminApplication","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Application details","content":{"*/*":{"schema":{"$ref":"#/compon