{"openapi":"3.1.0","info":{"title":"PKKA Backend API","description":"REST API for the Alumni Club platform of the AGH Faculty of Computer Science.","version":"v1"},"servers":[{"url":"http://localhost:8080","description":"Local dev"}],"tags":[{"name":"Profiles","description":"Own user profile management — requires USER role"},{"name":"Admin Applications","description":"Reviewer actions on alumnus applications"},{"name":"Event registrations","description":"Signing up for events — any signed-in user, limited by the event's audience"},{"name":"User Tags","description":"Available alumni skill tags — requires USER role"},{"name":"Events","description":"Public events calendar"},{"name":"Me","description":"Current user identity and roles"},{"name":"Posts","description":"Public posts on the faculty blog"},{"name":"Admin Posts","description":"Blog post management for administrators"},{"name":"Applications","description":"Alumnus applications submitted by the logged-in user"},{"name":"Alumni","description":"Alumni directory — requires VERIFIED_ALUMN role"},{"name":"Admin Events","description":"Event management for administrators"},{"name":"Tags","description":"Available event tags (e.g. \"workshop\", \"networking\") — requires USER role. Alumni skill tags live under /api/user-tags."},{"name":"Push devices","description":"Push tokens, one per app installation"}],"paths":{"/api/profiles/me/tags":{"get":{"tags":["Profiles"],"summary":"Get own assigned tags","operationId":"getMyTags","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserTagResponse"}}}}}}},"put":{"tags":["Profiles"],"summary":"Replace own tags (full replacement of the assigned set)","operationId":"updateMyTags","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateTagsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserTagResponse"}}}}},"400":{"description":"One or more tag IDs do not exist","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/notifications/devices/{installationId}":{"put":{"tags":["Push devices"],"summary":"Register or update this installation's push token","description":"The `installationId` is minted by the app on first launch and stays put; the push token\nbehind it is rotated by the push service and changes. Sending the same id again therefore\nupdates the token in place rather than adding a device, which makes this safe to call on\nevery login and on every token rotation.\n\nA token already held by a different installation is released first — Android hands the same\ntoken to a reinstalled app, and two rows holding it would push to that device twice.\n","operationId":"registerDevice","parameters":[{"name":"installationId","in":"path","required":true,"schema":{"type":"string","maxLength":64,"minLength":0}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterDeviceRequest"}}},"required":true},"responses":{"204":{"description":"Token stored"},"400":{"description":"Malformed push token","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}},"delete":{"tags":["Push devices"],"summary":"Forget this installation","description":"Called on logout and when the user turns notifications off — the absence of a row is what\nstops the sending, so there is no separate enabled flag to keep in step.\n","operationId":"unregisterDevice","parameters":[{"name":"installationId","in":"path","required":true,"schema":{"type":"string","maxLength":64,"minLength":0}}],"responses":{"204":{"description":"Device forgotten"},"404":{"description":"No such installation for this user","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/admin/posts/{id}":{"get":{"tags":["Admin Posts"],"summary":"Get a single post with content, regardless of status","operationId":"getAdminPost","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Post details","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminPostResponse"}}}},"404":{"description":"Post not found"}}},"put":{"tags":["Admin Posts"],"summary":"Update a post's editable fields and publish it; publication cannot be undone","operationId":"updateAdminPost","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdatePostRequest"}}},"required":true},"responses":{"200":{"description":"Post updated","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminPostResponse"}}}},"404":{"description":"Post not found"},"409":{"description":"Post is published and cannot revert to a draft"}}},"delete":{"tags":["Admin Posts"],"summary":"Delete a post permanently","operationId":"deleteAdminPost","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Post deleted"},"404":{"description":"Post not found"}}}},"/api/admin/events/{id}":{"get":{"tags":["Admin Events"],"summary":"Get a single event regardless of audience or start date","operationId":"getAdminEvent","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Event details","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminEventResponse"}}}},"404":{"description":"Event not found"}}},"put":{"tags":["Admin Events"],"summary":"Replace an event's editable fields","description":"Full replacement: every editable field is taken from the body, so omitted optional fields are cleared.","operationId":"updateAdminEvent","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EventRequest"}}},"required":true},"responses":{"200":{"description":"Event updated","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminEventResponse"}}}},"404":{"description":"Event not found"}}},"delete":{"tags":["Admin Events"],"summary":"Soft-delete an event","operationId":"deleteAdminEvent","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Event deleted"},"404":{"description":"Event not found"}}}},"/api/public/auth/refresh":{"post":{"tags":["auth-refresh-controller"],"operationId":"refresh","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TokenResponse"}}}}}}},"/api/public/auth/logout":{"post":{"tags":["auth-refresh-controller"],"operationId":"logout","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshRequest"}}},"required":true},"responses":{"204":{"description":"No Content"}}}},"/api/events/{eventId}/registration":{"post":{"tags":["Event registrations"],"summary":"Sign the current user up for an event","description":"Takes one seat, atomically with respect to other sign-ups for the same event: an event\nwith a seat limit can never be oversold. Conflicts carry a `reason` property\n(`ALREADY_REGISTERED`, `REGISTRATION_CLOSED`, `NO_SEATS_LEFT`) so they can be told apart\nwithout parsing the message. Registration closes at `registrationClosesAt`, and at the\nevent's start in any case.\n\nWho may sign up follows the event's `audience`, exactly like who may see it: `PUBLIC`\nevents are open to every signed-in user, `ALL_ALUMNI` events to verified alumni only.\nAn event the caller cannot see reports 404 rather than 403.\n","operationId":"register","parameters":[{"name":"eventId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"201":{"description":"Seat taken","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventRegistrationResponse"}}}},"404":{"description":"No such event, or it is not visible to this user","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"Already registered, registration closed, or no seats left","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}},"delete":{"tags":["Event registrations"],"summary":"Cancel the current user's registration","description":"Frees the seat. Before `registrationClosesAt` someone else can claim it; after that\nnobody can, but dropping out still keeps the organiser's head count honest, so it stays\nallowed. Once the event has started it achieves neither and is rejected with a `reason`\nof `EVENT_ALREADY_STARTED`.\n","operationId":"unregister","parameters":[{"name":"eventId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Seat freed"},"404":{"description":"No such event, or the user is not registered for it","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"The event has already started","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/applications":{"post":{"tags":["Applications"],"summary":"Submit an alumnus application for the current user","operationId":"createApplication","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateApplicationRequest"}}},"required":true},"responses":{"201":{"description":"Application created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApplicationResponse"}}}},"400":{"description":"Validation failed"},"409":{"description":"The user already has an application under review"}}}},"/api/admin/posts":{"get":{"tags":["Admin Posts"],"summary":"List all posts including drafts, newest first, optionally filtered by status","operationId":"listAdminPosts","parameters":[{"name":"status","in":"query","required":false,"schema":{"$ref":"#/components/schemas/PostStatus"}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageAdminPostListItemResponse"}}}}}},"post":{"tags":["Admin Posts"],"summary":"Create a post with a slug generated from the title; status defaults to DRAFT","operationId":"createAdminPost","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePostRequest"}}},"required":true},"responses":{"201":{"description":"Post created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminPostResponse"}}}}}}},"/api/admin/events":{"get":{"tags":["Admin Events"],"summary":"List all events including past and alumni-only, optionally filtered by timeframe","operationId":"listAdminEvents","parameters":[{"name":"timeframe","in":"query","required":false,"schema":{"$ref":"#/components/schemas/EventTimeframe"}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["startsAt,DESC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageAdminEventSummaryResponse"}}}}}},"post":{"tags":["Admin Events"],"summary":"Create an event","operationId":"createAdminEvent","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EventRequest"}}},"required":true},"responses":{"201":{"description":"Event created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminEventResponse"}}}}}}},"/api/admin/applications/{id}/reject":{"post":{"tags":["Admin Applications"],"summary":"Reject an application with an optional reason","operationId":"reject","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RejectApplicationRequest"}}}},"responses":{"200":{"description":"Application rejected","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApplicationResponse"}}}},"404":{"description":"Application not found"},"409":{"description":"Application is not under review"}}}},"/api/admin/applications/{id}/approve":{"post":{"tags":["Admin Applications"],"summary":"Approve an application and grant the verified alumn role","operationId":"approve","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Application approved","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApplicationResponse"}}}},"404":{"description":"Application not found"},"409":{"description":"Application is not under review"}}}},"/api/profiles/me":{"get":{"tags":["Profiles"],"summary":"Get own profile","operationId":"getMyProfile","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProfileResponse"}}}}}},"patch":{"tags":["Profiles"],"summary":"Update own profile","description":"Partial update: null/omitted fields are left unchanged; a blank string clears the value","operationId":"updateMyProfile","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProfileRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProfileResponse"}}}}}}},"/debug/token":{"get":{"tags":["debug-token-controller"],"operationId":"debugToken","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"type":"object","additionalProperties":{}}}}}}}}},"/api/user-tags":{"get":{"tags":["User Tags"],"summary":"List all available alumni skill tags","operationId":"listUserTags","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserTagResponse"}}}}}}}},"/api/tags":{"get":{"tags":["Tags"],"summary":"List all available event tags","operationId":"listTags","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TagResponse"}}}}}}}},"/api/public/posts":{"get":{"tags":["Posts"],"summary":"List of published posts","description":"Available without authentication. Posts are ordered from newest to oldest.\nPagination parameters: page (default 0), size (default 10).\n","operationId":"listPosts","parameters":[{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":10,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagePostSummaryResponse"}}}}}}},"/api/public/posts/{slug}":{"get":{"tags":["Posts"],"summary":"Single post by slug","description":"Available without authentication. Returns 404 if the post does not exist or is a draft.","operationId":"getPost","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PostResponse"}}}},"404":{"description":"Post does not exist or is not published"}}}},"/api/public/events":{"get":{"tags":["Events"],"summary":"List events (upcoming by default, optional past archive and tag filter)","operationId":"listEvents","parameters":[{"name":"tags","in":"query","required":false,"schema":{"type":"array","items":{"type":"string"},"uniqueItems":true}},{"name":"timeframe","in":"query","required":false,"schema":{"$ref":"#/components/schemas/EventTimeframe"}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["startsAt,ASC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageEventListItemResponse"}}}}}}},"/api/public/events/{id}":{"get":{"tags":["Events"],"summary":"Details of a single event","operationId":"getEventById","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventDetailsResponse"}}}}}}},"/api/public/auth/post-logout":{"get":{"tags":["web-logout-redirect-controller"],"operationId":"postLogout","responses":{"200":{"description":"OK"}}}},"/api/me":{"get":{"tags":["Me"],"summary":"Current user info","description":"Returns identity claims and realm roles for the currently authenticated user.\nWorks for both web (OIDC session) and mobile (Bearer JWT) flows.\nRoles are returned without the ROLE_ prefix.\n","operationId":"me","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MeResponse"}}}}}}},"/api/applications/me":{"get":{"tags":["Applications"],"summary":"Get the current user's application","operationId":"getMine","responses":{"200":{"description":"The user's most recent application","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApplicationResponse"}}}},"404":{"description":"The user has no application"}}}},"/api/alumni":{"get":{"tags":["Alumni"],"summary":"Search and list alumni","description":"Paginated, filterable alumni directory of verified alumni only (users without an approved\napplication never appear here, even if they hold a local account). `q` matches\n(case-insensitively, substring) against first/last name (unless the alumnus hides their name),\ncurrent position, company and assigned skill tag names. `tagIds` matches alumni who have at\nleast one of the given skill tags (OR semantics). `mentor=true`/`mentor=false` restricts to\nalumni who are/aren't willing to mentor. `graduationYearFrom`/`graduationYearTo` bound the\ngraduation year inclusively, and either may be given on its own to leave that end open.\nAll filters are combined with AND.\nUnknown tag IDs simply match no one instead of returning an error, since this is a search\nfilter rather than a write operation.\nSortable fields are columns of the alumnus' own record: `lastName`, `firstName`,\n`graduationYear`, `createdAt`. Requesting any other sort property is rejected with 400.\n","operationId":"listAlumni","parameters":[{"name":"q","in":"query","required":false,"schema":{"type":"string"}},{"name":"tagIds","in":"query","required":false,"schema":{"type":"array","items":{"type":"string","format":"uuid"},"uniqueItems":true}},{"name":"mentor","in":"query","required":false,"schema":{"type":"boolean"}},{"name":"graduationYearFrom","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"graduationYearTo","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["createdAt,DESC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageAlumniListItemResponse"}}}},"400":{"description":"Unsupported sort property","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/alumni/{id}":{"get":{"tags":["Alumni"],"summary":"Get public alumni profile by user id","operationId":"getAlumniProfile","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AlumniProfileResponse"}}}},"404":{"description":"No user with the given id, or that user is not a verified alumnus (no approved application)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/admin/applications":{"get":{"tags":["Admin Applications"],"summary":"List applications with full details, filtered by status (newest first)","operationId":"listAdminApplications","parameters":[{"name":"status","in":"query","required":false,"schema":{"$ref":"#/components/schemas/ApplicationStatus","default":"UNDER_REVIEW"}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageAdminApplicationResponse"}}}}}}},"/api/admin/applications/{id}":{"get":{"tags":["Admin Applications"],"summary":"Get full details of a single application","operationId":"getAdminApplication","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Application details","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminApplicationResponse"}}}},"404":{"description":"Application not found"}}}}},"components":{"schemas":{"UpdateTagsRequest":{"type":"object","properties":{"tagIds":{"type":"array","description":"Full replacement set of tag IDs","items":{"type":"string","format":"uuid"},"maxItems":20,"minItems":0,"uniqueItems":true}},"required":["tagIds"]},"ProblemDetail":{"type":"object","properties":{"type":{"type":"string","format":"uri"},"title":{"type":"string"},"status":{"type":"integer","format":"int32"},"detail":{"type":"string"},"instance":{"type":"string","format":"uri"},"properties":{"type":"object","additionalProperties":{}}}},"UserTagResponse":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"}},"required":["id","name"]},"DevicePlatform":{"type":"string","enum":["ANDROID","IOS"]},"RegisterDeviceRequest":{"type":"object","properties":{"token":{"type":"string","example":"ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]","maxLength":255,"minLength":0,"pattern":"^(Expo(nent)?PushToken\\[[^\\]]+\\]|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"},"platform":{"$ref":"#/components/schemas/DevicePlatform"}},"required":["platform","token"]},"PostStatus":{"type":"string","enum":["DRAFT","PUBLISHED"]},"UpdatePostRequest":{"type":"object","properties":{"title":{"type":"string","maxLength":300,"minLength":0},"content":{"type":"string","description":"Markdown","minLength":1},"status":{"$ref":"#/components/schemas/PostStatus"}},"required":["content","status","title"]},"AdminPostResponse":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"slug":{"type":"string"},"title":{"type":"string"},"content":{"type":"string"},"status":{"$ref":"#/components/schemas/PostStatus"},"authorDisplayName":{"type":"string"},"publishedAt":{"type":"string","format":"date-time"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}},"required":["authorDisplayName","content","createdAt","id","slug","status","title","updatedAt"]},"Audience":{"type":"string","enum":["PUBLIC","ALL_ALUMNI","SPECIFIC_GROUP"]},"EventRequest":{"type":"object","properties":{"title":{"type":"string","maxLength":200,"minLength":0},"fullDescription":{"type":"string"},"type":{"$ref":"#/components/schemas/EventType"},"startsAt":{"type":"string","format":"date-time"},"endsAt":{"type":"string","format":"date-time"},"transmissionUrl":{"type":"string","maxLength":500,"minLength":0},"location":{"type":"string","maxLength":300,"minLength":0},"seatLimit":{"type":"integer","format":"int32","minimum":0},"registrationClosesAt":{"type":"string","format":"date-time"},"audience":{"$ref":"#/components/schemas/Audience"},"coverImageUrl":{"type":"string","maxLength":500,"minLength":0},"tags":{"type":"array","items":{"type":"string","maxLength":32,"minLength":0},"uniqueItems":true}},"required":["audience","endsAt","startsAt","title","type"]},"EventType":{"type":"string","enum":["ONLINE","IN_PERSON","HYBRID"]},"AdminEventResponse":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"title":{"type":"string"},"fullDescription":{"type":"string"},"type":{"$ref":"#/components/schemas/EventType"},"startsAt":{"type":"string","format":"date-time"},"endsAt":{"type":"string","format":"date-time"},"transmissionUrl":{"type":"string"},"location":{"type":"string"},"seatLimit":{"type":"integer","format":"int32"},"seatsTaken":{"type":"integer","format":"int32","description":"Registrations for this event so far"},"registrationClosesAt":{"type":"string","format":"date-time"},"audience":{"$ref":"#/components/schemas/Audience"},"coverImageUrl":{"type":"string"},"tags":{"type":"array","items":{"type":"string"},"uniqueItems":true},"authorDisplayName":{"type":"string","description":"Admin who created the event; absent for events that predate authorship tracking"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}},"required":["audience","createdAt","endsAt","id","seatsTaken","startsAt","tags","title","type","updatedAt"]},"RefreshRequest":{"type":"object","properties":{"refreshToken":{"type":"string"}}},"TokenResponse":{"type":"object","properties":{"access_token":{"type":"string"},"refresh_token":{"type":"string"}}},"EventRegistrationResponse":{"type":"object","properties":{"eventId":{"type":"string","format":"uuid"},"registeredAt":{"type":"string","format":"date-time"},"seatsTaken":{"type":"integer","format":"int32","description":"Seats taken, including this registration"},"seatLimit":{"type":"integer","format":"int32","description":"Absent when the event has no seat limit"}},"required":["eventId","registeredAt","seatsTaken"]},"ConsentType":{"type":"string","enum":["REGULATIONS_PRIVACY","GDPR_DATA_PROCESSING"]},"CreateApplicationRequest":{"type":"object","properti