{
  "expo": {
    "name": "pkka",
    "slug": "pkka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pkka",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pkka.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "userInterfaceStyle": "automatic",
      "package": "com.pkka.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#011125"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Jost",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Jost_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Jost_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Jost_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Jost_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Montserrat",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Montserrat_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Montserrat_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Montserrat_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Montserrat_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Montserrat_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Jost_400Regular.ttf",
              "./assets/fonts/Jost_500Medium.ttf",
              "./assets/fonts/Jost_600SemiBold.ttf",
              "./assets/fonts/Jost_700Bold.ttf",
              "./assets/fonts/Montserrat_400Regular.ttf",
              "./assets/fonts/Montserrat_500Medium.ttf",
              "./assets/fonts/Montserrat_600SemiBold.ttf",
              "./assets/fonts/Montserrat_700Bold.ttf",
              "./assets/fonts/Montserrat_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
